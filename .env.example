# ═══════════════════════════════════════════════
# NeuroDesk AI — Environment Variables
# ═══════════════════════════════════════════════
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ═══════════════════════════════════════════════

# ──── Server ────
NODE_ENV=development
SERVER_PORT=3001
SERVER_HOST=localhost

# ──── Frontend ────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001

# ──── Database ────
DATABASE_URL="file:../data/neurodesk.db"

# ──── Authentication ────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
JWT_SECRET=generate_a_random_32_char_string_here
JWT_EXPIRY=7d

# ──── AI Providers ────
# Default provider: gemini | openai | ollama
AI_DEFAULT_PROVIDER=gemini
AI_DEFAULT_MODEL=gemini-2.0-flash

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (optional)
OPENAI_API_KEY=

# Ollama (optional — auto-detected if running)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1:8b

# ──── AI Service (Python FastAPI) ────
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000

# ──── Embedding ────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ──── ChromaDB ────
CHROMA_PERSIST_DIR=./data/chromadb

# ──── OCR ────
TESSERACT_PATH=C:/Program Files/Tesseract-OCR/tesseract.exe

# ──── Logging ────
LOG_LEVEL=info
LOG_DIR=./data/logs

# ──── Cache ────
CACHE_DIR=./data/cache

# ──── Security ────
ENCRYPTION_SALT=generate_a_random_16_char_salt_here

# ──── Workspace Defaults ────
MAX_FILE_SIZE_MB=100
SCAN_DEPTH_LIMIT=10
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=50
