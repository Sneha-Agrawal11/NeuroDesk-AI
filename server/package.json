    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "glob": "^11.0.0",
    "google-auth-library": "^9.10.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "multer": "^2.2.0",
    "node-cache": "^5.1.2",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
